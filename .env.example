# Copy to .env.local for development, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Required for the contact form (src/app/api/contact/route.ts).
RESEND_API_KEY=

# Optional but recommended: Cloudflare Turnstile anti-bot challenge on the contact form.
# Create a widget at https://dash.cloudflare.com → Turnstile (mode "Managed", domain thyssendigital.fr).
# Both keys must be set for the check to be enforced; without them the form works unprotected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: enables live Google reviews on the homepage (src/lib/google-reviews.ts).
# Create a key in Google Cloud Console with "Places API (New)" enabled, restricted by API
# (no HTTP referrer restriction needed since this key is only used server-side).
# Without this key, the reviews section falls back to a "leave a review" call to action.
GOOGLE_PLACES_API_KEY=
